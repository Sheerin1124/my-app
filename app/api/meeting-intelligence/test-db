import { supabase } from "@/lib/supabase";

export async function GET() {
  const { data, error } = await supabase
    .from("meetings")
    .select("*")
    .limit(1);

  if (error) {
    return Response.json({
      connected: false,
      error: error.message,
    });
  }

  return Response.json({
    connected: true,
    message: "Supabase connected successfully!",
    data,
  });
}